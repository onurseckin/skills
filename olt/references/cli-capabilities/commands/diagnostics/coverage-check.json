      "repeatable": false,
      "default": "0.95"
    },
    {
      "name": "dir",
      "type": "string",
      "required": false,
      "repeatable": false,
      "default": null
    },
    {
      "name": "strict",
      "type": "bool",
      "required": false,
      "repeatable": false,
      "default": null
    }
  ],
  "reads_stdin": false,
  "takes_remainder": false
}
