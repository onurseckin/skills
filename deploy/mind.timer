[Unit]
Description=Mind Consciousness Pulse Timer
Documentation=https://github.com/onurseckin/skills
After=network.target

[Timer]
# Fire 1 minute after boot to establish initial pulse
OnBootSec=1min
# Fire 15 minutes after the previous pulse unit becomes inactive
OnUnitInactiveSec=15min
# Load-bearing: ensures missed pulses after reboot or suspend fire immediately
# instead of silently skipping to the next slot
Persistent=yes
# Target service unit to trigger
Unit=mind.service

[Install]
WantedBy=timers.target
