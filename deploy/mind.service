[Unit]
Description=Mind Consciousness Pulse Service
Documentation=https://github.com/onurseckin/skills
After=network.target

[Service]
# Pulse is a bounded batch run that performs one pulse cycle and exits
Type=oneshot
# Path to pulse execution script and target capsule
ExecStart=/opt/mind/pulse.sh /srv/repo/.capsules/mind-gen-1
# Pulse deadline + safety slack (30 minutes)
TimeoutStartSec=1800
# Load-bearing: prevents crash looping on poisoned capsules, ensuring failure waits for next timer tick
Restart=no

[Install]
WantedBy=default.target
