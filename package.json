{
  "name": "@onurseckin/skills",
  "version": "0.1.0",
  "private": true,
  "description": "Personal collection of autonomous agent skills for AI assistants",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "antigravity",
    "chatgpt",
    "claude-code",
    "codex",
    "skills"
  ],
  "license": "MIT",
  "author": "Onur Seçkin Şenoğlu",
  "type": "module",
  "scripts": {
    "test": "bun scripts/testing/test-runner.ts tests/unit",
    "test:all": "bun scripts/testing/test-runner.ts tests",
    "test:changed": "bun scripts/testing/test-changed.ts",
    "test:coverage": "bun scripts/testing/test-runner.ts --coverage tests/unit",
    "coverage:check": "bun test:coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --quiet",
    "format": "oxfmt '!**/.olt/capsules/**' '!**/.olt/scratch/**'",
    "format:check": "oxfmt '!**/.olt/capsules/**' '!**/.olt/scratch/**' --check",
    "modularity:staged": "bun scripts/modularity/check.ts --mode ratchet --source index",
    "modularity:check": "bun scripts/modularity/check.ts --mode ratchet --source tree",
    "sync": "bun scripts/sync/index.ts",
    "sync:local": "bun run sync",
    "sync:remote": "npx skills update olt -g -y"
  },
  "dependencies": {
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.7.3"
  }
}
