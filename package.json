{
  "name": "@onurseckin/skills",
  "version": "0.1.0",
  "private": true,
  "description": "Personal collection of autonomous agent skills for AI assistants",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "antigravity",
    "chatgpt",
    "claude-code",
    "codex",
    "skills"
  ],
  "license": "MIT",
  "author": "Onur Seçkin Şenoğlu",
  "type": "module",
  "scripts": {
    "test": "bun test --timeout 30000 --parallel tests/unit",
    "test:unit": "bun test --timeout 30000 --parallel tests/unit",
    "test:integration": "bun test --timeout 30000 tests/integration",
    "test:integrations": "bun test --timeout 30000 tests/integration",
    "test:all": "bun run test:unit && bun run test:integration",
    "test:coverage": "bun test --timeout 30000 --coverage tests/unit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.13.0",
    "oxfmt": "^0.63.0",
    "typescript": "^5.7.3"
  }
}
